# A simple program to check the strength of a password entered by the user.

user_password = ""
save_pass_lenght = 12
has_digit = False
has_specChar = False
has_capital = False
while len(user_password) < save_pass_lenght or has_digit == False or has_specChar == False or has_capital == False:
        user_password = input("Password :")


        if len(user_password) < save_pass_lenght and has_digit == False:
            print(f"password have {len(user_password)} chcracters")
            print ("It's to short ")

        for char in user_password:
            if char in "1234567890":
                has_digit = True
        for spec_char in user_password:
            if spec_char in "!@#$%^&*()":
                has_specChar = True
        for cap_char in user_password:
            if cap_char.isupper():
                has_capital = True

if len(user_password) >= save_pass_lenght and has_digit ==True and has_specChar ==True:
    print ("Bravo, your password is good and safe")

